{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "presetLists": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          "$listId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "events": {
      ".indexOn": ["organizerId"],
      // Listing is allowed only for the query "events I organised". A plain
      // read of the whole node is denied, so the event list can no longer be
      // scanned. Both spellings are accepted because the client SDK sends
      // equalTo() on the wire as a range whose bounds are equal.
      ".read": "auth != null && query.orderByChild === 'organizerId' && ( query.equalTo === auth.uid || ( query.startAt === auth.uid && query.endAt === auth.uid ) )",
      // There is deliberately no ".write" here any more. It used to be
      // "auth != null", which let anyone the app gives an identity to write
      // anywhere under events and made every rule below it a dead letter.
      // See DOCS/PLANING/14-events-write-cascade.md.
      "$eventId": {
        ".read": "auth != null",
        ".write": "auth != null && ( !data.exists() || data.child('organizerId').val() === auth.uid || newData.child('organizerId').val() === auth.uid )",
        "details": {
          ".write": "auth != null && ( !data.exists() || root.child('events').child($eventId).child('organizerId').val() === auth.uid )"
        },
        "menuItems": {
          ".indexOn": ["creatorId"],
          // The second blanket permission, also removed: with it in place a
          // stranger could still wipe the whole menu of somebody else's event
          // in one write, and the per-item rule below would never be reached.
          "$itemId": {
            // Creating: the organizer always may. For everybody else the event
            // form's three switches are read as the three independent things
            // they are, because that is what they are on screen: offering a
            // ride answers to "allow ride offers", asking for one answers to
            // "allow ride requests", and everything else answers to "allow
            // participant items" plus the quota. Folding the rides inside the
            // item switch is what refused a ride in an event where the
            // organizer had switched items off and left rides on - and ride
            // offers are on by default, so that pairing is ordinary.
            // See DOCS/PLANING/29-rides-blocked-by-user-items-setting.md.
            //
            // A missing switch reads as off, the same way the event screen
            // reads it. A missing quota reads as three, the same default the
            // screens use.
            //
            // An ordinary item must arrive together with the writer's own
            // counter, stepped up by exactly one and still inside the quota.
            // Without that the quota only held against a client that chose to
            // report: an item written on its own read as "this person has never
            // added anything", every time, and eight of them went into an event
            // with a quota of three. The counter is read through newData so
            // that it is the value the same write is about to leave behind, not
            // the one already stored. Rides are exempt because they do not
            // count against the quota and so no longer carry a counter at all.
            //
            // Whoever the item says created it must be the one writing it, and
            // the field is frozen afterwards - checking it only on the way in
            // would let somebody create an item in their own name and then hand
            // it over by editing the field. The freeze is conditional on the
            // item still existing, or deleting one would read as changing it.
            // The organizer is exempt from both, and needs to be: bulk item
            // management records items under a fixed name, and turning a
            // participant's one-way ride into a round trip copies that
            // participant onto the new leg.
            // See DOCS/PLANING/30-item-rules-trust-the-client.md.
            //
            // Four category names count as a ride, matching RIDE_CATEGORY_IDS
            // in src/utils/eventUtils.ts - `trempim` and `rides` are older
            // names still present in existing events. This list and that one
            // had drifted apart, so an item in the name only one of them knew
            // was exempt from the quota on screen and counted against it here.
            // See DOCS/PLANING/31-rides-consume-the-item-quota.md.
            // Editing and deleting: the organizer, or whoever created the item.
            ".write": "auth != null && ((!data.exists() && (root.child('events').child($eventId).child('organizerId').val() === auth.uid || (newData.child('creatorId').val() === auth.uid && (((newData.child('category').val() === 'ride_offers' || newData.child('category').val() === 'trempim' || newData.child('category').val() === 'rides') && root.child('events').child($eventId).child('details').child('allowRideOffers').val() === true) || (newData.child('category').val() === 'ride_requests' && root.child('events').child($eventId).child('details').child('allowRideRequests').val() === true) || (root.child('events').child($eventId).child('details').child('allowUserItems').val() === true && ((!root.child('events').child($eventId).child('userItemCounts').child(auth.uid).exists() && newData.parent().parent().child('userItemCounts').child(auth.uid).val() === 1 && 1 <= (root.child('events').child($eventId).child('details').child('userItemLimit').exists() ? root.child('events').child($eventId).child('details').child('userItemLimit').val() : 3)) || (root.child('events').child($eventId).child('userItemCounts').child(auth.uid).exists() && newData.parent().parent().child('userItemCounts').child(auth.uid).val() === root.child('events').child($eventId).child('userItemCounts').child(auth.uid).val() + 1 && newData.parent().parent().child('userItemCounts').child(auth.uid).val() <= (root.child('events').child($eventId).child('details').child('userItemLimit').exists() ? root.child('events').child($eventId).child('details').child('userItemLimit').val() : 3)))))))) || (data.exists() && (root.child('events').child($eventId).child('organizerId').val() === auth.uid || (data.child('creatorId').val() === auth.uid && (!newData.exists() || newData.child('creatorId').val() === data.child('creatorId').val())))))",
            // Taking an item and giving it back. This is where the protection
            // against two people grabbing the same item now lives: the field
            // may be filled only while it is empty, and only with your own
            // name, so the server refuses the second person no matter what the
            // app does. Releasing is allowed only to whoever is holding it.
            "assignedTo": {
              ".write": "auth != null && ( (!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)) )"
            },
            // The label and the timestamp follow whoever holds the item, so
            // they may be written by the holder either before or after the
            // change - which covers taking it, giving it back, and renaming.
            "assignedToName": {
              ".write": "auth != null && ( newData.parent().child('assignedTo').val() === auth.uid || data.parent().child('assignedTo').val() === auth.uid )"
            },
            "assignedAt": {
              ".write": "auth != null && ( newData.parent().child('assignedTo').val() === auth.uid || data.parent().child('assignedTo').val() === auth.uid )"
            }
          }
        },
        "participants": {
          "$participantId": {
            ".write": "auth != null && $participantId === auth.uid"
          }
        },
        "assignments": {
          "$assignmentId": {
            // Your own sign-up, or the organizer removing one. The last clause
            // is new: deleting an item takes its sign-ups with it, and the
            // screen lets whoever created the item do that - it even counts the
            // people signed up in its confirmation.
            ".write": "auth != null && ( (newData.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('events').child($eventId).child('organizerId').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('events').child($eventId).child('menuItems').child(data.child('menuItemId').val()).child('creatorId').val() === auth.uid) )"
          }
        },
        "userItemCounts": {
          // Your own counter only, and only one step at a time, which is what
          // makes adding an item a compare-and-set.
          //
          // The two halves are kept apart on purpose. The arithmetic runs only
          // once there is a previous value to do arithmetic on: with the two
          // folded into one condition, a participant who has no counter yet -
          // every visitor arriving through an invitation link - was refused,
          // because the failed subtraction took the whole condition down before
          // the clause written to cover them was ever reached. That refusal took
          // the item down with it, since both are sent as one write.
          // See DOCS/PLANING/28-visitor-cannot-add-own-item.md.
          //
          // A first counter may only be one. Anything else would let a client
          // open at any number and step straight past the quota.
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ( (!data.exists() && newData.val() === 1) || (data.exists() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1)) )"
          }
        }
      }
    },
    // Legacy node. Live preset lists moved to users/$uid/presetLists; one
    // abandoned record remains here. Restricted to its owner.
    "presetLists": {
      "$listId": {
        ".read": "auth != null && data.child('createdBy').val() === auth.uid",
        ".write": "auth != null && ( !data.exists() || data.child('createdBy').val() === auth.uid ) && ( !newData.exists() || newData.child('createdBy').val() === auth.uid )"
      }
    },
    "admins": {
      // Was ".read": true - readable by anyone on the internet, unauthenticated.
      // The node is currently empty and has no reader in live code; the first
      // admin is still added through the console, as before.
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".write": "root.child('admins').child(auth.uid).exists()"
      }
    }
  }
}
